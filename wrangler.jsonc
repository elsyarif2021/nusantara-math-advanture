{
  "name": "nusantara-math-adventure-pro",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-22",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "nusantara-math-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }]
}
